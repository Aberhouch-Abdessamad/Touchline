# ---------------------------------------------------------------------------
# Touchline environment
# Copy this file to .env.local and edit the values you need.
# Football data comes from public APIs; AI match analysis additionally needs
# a private AI service key (optional — the rest of the app works without it).
# Never commit .env.local, and never publish the AI_* credentials: they are
# read server-side only and are never exposed to the browser or API responses.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, canonical URLs, sitemap.xml, robots.txt
# and share links. No trailing slash. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact address. When set, the contact form composes a real
# mailto: message. When empty, the contact page explains that no address is
# configured instead of pretending to send.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# AI match analysis (Touchline AI) — server-only, never exposed to the browser
# ---------------------------------------------------------------------------
# The only supported provider token. Any other value fails loudly on the
# server. This is an internal identifier, not a company or product name.
AI_PROVIDER=touchline-ai

# OpenAI-compatible AI service base URL, including the /v1 version segment.
# Set this in .env.local — the real address is private, like the key, and is
# intentionally absent from this file.
AI_BASE_URL=

# Bearer key for the AI service. Required for generating analyses;
# previously stored analyses remain viewable without it.
AI_API_KEY=

# Model id of the analysing assistant. Server-side only: it is never stored,
# returned or rendered. Users only ever see the public product name
# "Touchline AI".
AI_MODEL=

# Per-request timeout in ms (5s–120s), retry attempts on temporary failures,
# and the completion token budget for one analysis response. Reasoning-model
# upstreams bill hidden thinking tokens against this budget: keep it comfortably
# above the expected JSON size (the richer report needs ~7k) or the model can
# exhaust it before finishing and the JSON arrives truncated.
AI_TIMEOUT_MS=60000
AI_RETRIES=2
AI_MAX_TOKENS=12000
AI_TEMPERATURE=0.2

# Generate-calls allowed per client IP per hour (abuse guard; stored
# analyses are served without spending a call).
AI_RATE_LIMIT_PER_HOUR=10

# Site-wide ceiling on AI generations per rolling 24h, across all visitors.
# Protects your API key quota even if someone spreads requests over many IPs.
AI_DAILY_CAP=500

# Minimum seconds between two AI captures of the same in-play match
# (clamped to 30–1800). Real triggers (score, events, statistics) capture
# immediately; this only paces the interval safety capture. Default 120.
AI_LIVE_MIN_INTERVAL_SECONDS=120
